    <header>
      <a>
        <h1>Faster</h1>
        <h2>.com</h2></a>
      </header>
      <div class="restart-wrapper">
        <button id="restartButton" class="btn btn-outline-light restart-button" type="button">Restart</button>
      </div>
      <section class="type_this d-flex justify-content-center">
            <div class="card w-50">
                <div class="card-body bg-dark text-light" id="text">
                    Type everything you see
                </div>
            </div>
        </section>
            
        <section class="text-center">
                <input 
                    type="text" 
                    class="form-control w-50 mx-auto" 
                    id = "text_input"
                    placeholder="Start typing...Faster!">
        </section>
        <button 
            class="btn btn-secondary offcanvas-trigger" 
            type="button" 
            data-bs-toggle="offcanvas" 
            data-bs-target="#customPanel">
                Customize your Game
        </button>
        
        <div class="offcanvas offcanvas-end" 
             tabindex="-1" 
             id="customPanel"
             data-bs-theme="dark">
            <div class="offcanvas-header">
            <h5 class="offcanvas-title">
                Customize your Game</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        
        <div class="offcanvas-body" data-bs-theme="dark">
          <form data-bs-theme="dark">
            <fieldset>
              <legend>Select your options<br>to play your way!</legend>
                <div class="mb-3">
                  <label for="languageSelect" 
                         class="form-label">Select your Language</label>
                  <select 
                    id="languageSelect" 
                    class="form-select">
                    <option value="" disabled hidden></option>
                    <option value="english" selected>English</option>
                    <option value="greek">Greek</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="modeSelect" 
                         class="form-label">Select text type</label>
                  <select 
                    id="modeSelect" 
                    class="form-select">
                    <option value="" disabled hidden></option>
                    <option value="quotes">Quotes</option>
                    <option value="words" selected>Words</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="difficultySelect" 
                         class="form-label">Select difficulty</label>
                  <select 
                    id="difficultySelect" 
                    class="form-select">
                    <option value="" disabled hidden></option>
                    <option value="easy" selected>Easy</option>
                    <option value="medium">Medium</option>
                    <option value="hard">Hard</option>
                  </select>
                </div>
                <br>
                <button type="submit" class="btn btn-primary">Start the Game!</button>
            </fieldset>
          </form>
        </div>
</div>
