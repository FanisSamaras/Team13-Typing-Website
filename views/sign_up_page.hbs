  <div class="d-flex justifyd-flex justify-content-center align-items-center flex-grow-1">
      <div class="w-100" style="max-width: 450px;"> 
        <form action="#" class="p-4 rounded shadow bg-body" data-bs-theme="dark" style="max-width: auto; margin: auto;">
            <legend class="text-light">Sign up for Faster!</legend>
            <div class="mb-3">    
                <label for="username" class="form-label text-light">Username</label>
                <input type="text" class="form-control" id="username" data-bs-theme = "dark" placeholder="Username">
            </div>
            <div class="mb-3">
                <label for="email1" class="form-label text-light">Email</label>
                <input type="email" class="form-control" id="email1" data-bs-theme="dark" placeholder="Email">
            </div>
            <div class="mb-3">
                <label for="pass1" class="form-label text-light">Password</label>
                <input type="password" class="form-control" id="pass1" data-bs-theme="dark" placeholder="Password">
            </div>
            <div class="mb-3">
                <label for="pass2" class="form-label text-light">Confirm Password</label>
                <input type="password" class="form-control" id="pass2" data-bs-theme="dark" placeholder="Confirm Password">
            </div>
            <div>
                <button type="submit" class="btn btn-light w-100">Sign Up!</button>
            </div>
            <div class="mt-3 text-end">
                <p class="text-light"><a href="/login">Already have an account?</a></p>
            </div>
        </form>
    </div>
