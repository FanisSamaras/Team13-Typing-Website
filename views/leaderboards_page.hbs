    <br/>
    <div class="container mt-5 mb-5">
      <div
        class="card bg-secondary bg-opacity-10 text-light shadow-lg border-0 rounded-4 p-4"
        data-bs-theme="dark"
      >
        <h2 class="text-center mb-4">Leaderboard</h2>

        <table
          class="table table-dark table-borderless table-striped table-hover text-light text-center"
        >
          <thead style="border-bottom: 2px solid rgb(186, 3, 0)">
            <tr>
              <th>Rank</th>
              <th>Name</th>
              <th>WPM</th>
              <th>Accuracy</th>
              <th>Time</th>
            </tr>
          </thead>

          <tbody>
            {{#if scores}}
              {{#each scores}}
                <tr>
                  <td>{{rank}}</td>
                  <td>{{username}}</td>
                  <td>{{wpm}}</td>
                  <td>{{acc}}%</td>
                  <td>{{created_at}}</td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" class="text-center">No leaderboard entries yet.</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
