    <br/>
    <div class="container mt-5 mb-5">
      <div
        class="card bg-secondary bg-opacity-10 text-light shadow-lg border-0 rounded-4 p-4"
        data-bs-theme="dark">
        <h2 class="text-center mb-4">{{title}}</h2>

        <form class="row g-3 mb-4" method="get" action="/leaderboards">
          <div class="col-md-6">
            <label for="leaderboardLanguage" class="form-label">Language</label>
            <select id="leaderboardLanguage" name="language" class="form-select" onchange="this.form.submit()">
              <option value="all" {{#if selectedLanguageAll}}selected{{/if}}>All Languages</option>
              <option value="english" {{#if selectedLanguageEnglish}}selected{{/if}}>English</option>
              <option value="greek" {{#if selectedLanguageGreek}}selected{{/if}}>Greek</option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="leaderboardMode" class="form-label">Mode</label>
            <select id="leaderboardMode" name="mode" class="form-select" onchange="this.form.submit()">
              <option value="all" {{#if selectedModeAll}}selected{{/if}}>All Modes</option>
              <option value="quotes" {{#if selectedModeQuotes}}selected{{/if}}>Quotes</option>
              <option value="words" {{#if selectedModeWords}}selected{{/if}}>Words</option>
            </select>
          </div>
        </form>

        <table
          class="table table-dark table-borderless table-striped table-hover text-light text-center"
        >
          <thead style="border-bottom: 2px solid rgb(186, 3, 0)">
            <tr>
              <th>Rank</th>
              <th>Name</th>
              <th>Mode</th>
              <th>Language</th>
              <th>WPM</th>
              <th>Accuracy</th>
            </tr>
          </thead>

          <tbody>
            {{#if scores.length}}
              {{#each scores}}
                <tr>
                  <td>{{rank}}</td>
                  <td>{{username}}</td>
                  <td>{{mode}}</td>
                  <td>{{language}}</td>
                  <td>{{wpm}}</td>
                  <td>{{acc}}%</td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="6" class="text-center">No leaderboard entries yet.</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
