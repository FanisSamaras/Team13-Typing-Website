<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"/>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous">
    </script>
    <script src="https://kit.fontawesome.com/a175da0939.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/css/first_page.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Black+Ops+One&display=swap"
      rel="stylesheet">
    {{#if isHome}}<script src="/js/main.mjs" type="module"></script>{{/if}}
  </head>
  <body class="d-flex flex-column min-vh-100">
    <nav class="container-fluid">
      <ul>
        <li><a href="/" title="Home"><i class="fa-solid fa-house"></i></a></li>
        <li class="get_in"><a href="/leaderboards" title="Leaderboards"><i class="fa-solid fa-chart-simple"></i></a>
        </li>
        {{#if user}}
          {{!-- <li class="get_in"><a href="/logout">Logout</a></li> --}}
          <li class="get_in" title="User"><a href="/user_page"><i class="fa-solid fa-user"></i>{{user.username}}</a></li>
        {{else}}
          <li class="get_in" title="Log in/Sign up"><a href="/login"><i class="fa-solid fa-user"></i></a></li>
        {{/if}}
      </ul>
    </nav>
    {{{body}}}
    <footer class="mt-auto py-3">
      <div class="container text-center">
            <a href="https://github.com/FanisSamaras/Team13-Typing-Website" target="_blank"><i class="fa-brands fa-github fa-2x"></i></a>
      </div>
    </footer>
  </body>
</html>
